# Copy to .env for native (non-Docker) runs. Under docker compose these are
# set in docker-compose.yml instead and this file is not read.

ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://presprint:presprint@localhost:5432/presprint_quotes
NLP_CONFIDENCE_THRESHOLD=0.55
# Back office: /admin/* history + export, and the staff-only order routes.
# Blank means those endpoints stay CLOSED — they never fall open, not even
# when ENVIRONMENT=development. Must be at least 16 characters.
#     openssl rand -hex 32
# Under docker compose this comes from the repo-root .env, not this file.
ADMIN_API_KEY=

# Where the rate matrices are read from. Leave blank to use the copy shipped
# next to the app (backend/pricing_matrix.json). Docker compose points this at
# a mounted config volume so rates can change without rebuilding the image.
PRICING_MATRIX_PATH=
